# Cyconet — environment variables
#
# Copy to `.env.local` for local development and fill in real values:
#     cp .env.example .env.local
#
# `.env*` files are gitignored. Set the same variables in your host's dashboard
# (Vercel, Netlify, Render…) for preview and production deployments — .env.local
# is never deployed.


# ─────────────────────────────────────────────────────────────────────────────
# Site origin — REQUIRED in production
# ─────────────────────────────────────────────────────────────────────────────
#
# The canonical public origin. Everything absolute derives from this single
# value: metadataBase, <link rel="canonical">, Open Graph URLs, sitemap.xml,
# robots.txt and every @id in the JSON-LD graph.
#
# Include the scheme. A bare domain is normalized to https:// automatically,
# but being explicit avoids surprises.
#
# Pick ONE host and stay on it. If you serve both www.cyconet.ng and cyconet.ng,
# redirect one to the other at the DNS/host level — otherwise the same pages
# exist at two URLs and their ranking signals are split between them.
#
# Defaults to https://cyconet.com when unset, which is almost certainly wrong
# for your deployment.
NEXT_PUBLIC_SITE_URL=https://www.cyconet.ng


# ─────────────────────────────────────────────────────────────────────────────
# Lead delivery — REQUIRED in production
# ─────────────────────────────────────────────────────────────────────────────
#
# Where form submissions go: applications, agency enquiries, hub tour requests
# and newsletter signups.
#
# All three must be set together. If any is missing:
#   • in development  → submissions are appended to .leads.jsonl (gitignored)
#     so you can test the flow without an email provider
#   • in production   → the form REFUSES the submission and tells the visitor
#     to email you directly. This is deliberate: silently accepting an
#     application that goes nowhere is worse than an honest error.
#
# Swapping Resend for a CRM, database or another provider means rewriting
# `deliver()` in src/lib/leads.ts and nothing else.

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. The DOMAIN MUST BE VERIFIED IN RESEND or every send fails.
#
# This must be a domain you control — keep it on cyconet.ng. You cannot send
# from an outlook.com / gmail.com address here, because verification requires
# adding DNS records to the domain and you do not own Microsoft's.
LEAD_FROM_EMAIL="Cyconet <noreply@cyconet.ng>"

# Where submissions land. Any address you can actually read — this one has no
# verification requirement, so cyconet@outlook.com is fine. A shared inbox
# beats one person's address once more than one person handles admissions.
LEAD_NOTIFY_EMAIL=cyconet@outlook.com


# ─────────────────────────────────────────────────────────────────────────────
# Database — REQUIRED
# ─────────────────────────────────────────────────────────────────────────────
#
# Postgres connection string for the learning platform: students, enrollments,
# curriculum, progress, exams, projects, certificates and the timetable.
#
# Any Postgres works — Neon, Supabase, Railway, Vercel Postgres, or one you run
# yourself. Managed providers usually require TLS, so keep `?sslmode=require`
# on the end unless yours says otherwise.
#
# After setting this, create the tables with:
#     npx prisma db push
#     npx prisma db seed     # demo programmes, users and timetable
DATABASE_URL="postgresql://postgres.bmfvesrfjeidcmtupiwc:#1Oluwakorede@aws-1-eu-west-3.pooler.supabase.com:6543/postgres"


# ─────────────────────────────────────────────────────────────────────────────
# Session signing — REQUIRED in production
# ─────────────────────────────────────────────────────────────────────────────
#
# Signs the session cookie that keeps students and staff logged in. Generate a
# fresh one — never reuse the example, and never commit the real value:
#
#     openssl rand -base64 32
#
# Changing it logs everyone out, which is also how you revoke every session at
# once if you ever need to.
SESSION_SECRET="gDkcrfEqkEN6mkU4DGTt6fSxNfyX3ZQByhIJ03pwubw="


# ─────────────────────────────────────────────────────────────────────────────
# Root domain — REQUIRED in production
# ─────────────────────────────────────────────────────────────────────────────
#
# The apex the subdomains hang off. src/proxy.ts compares the incoming Host
# against this to decide which tenant is being addressed:
#
#     learning.<root>  → the student hub
#     admin.<root>     → the staff dashboard
#     <root> / www     → the public marketing site
#
# No scheme, no www, no trailing slash. In development the proxy also accepts
# learning.localhost / admin.localhost regardless of this value, so local work
# needs no DNS or /etc/hosts changes.
NEXT_PUBLIC_ROOT_DOMAIN=cyconet.ng
