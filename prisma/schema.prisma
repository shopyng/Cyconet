// Cyconet learning platform database schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Users & Authentication
// ============================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // bcrypt hashed
  name      String
  role      Role     @default(STUDENT)
  createdAt DateTime @default(now())

  enrollments        Enrollment[]
  progress           Progress[]
  examAttempts       ExamAttempt[]
  examSessions       ExamSession[]
  projectSubmissions ProjectSubmission[]
  certificates       Certificate[]
  payments           Payment[]
  notifications      Notification[]
  auditLogs          AuditLog[]
}

enum Role {
  STUDENT
  ADMIN
}

// ============================================================================
// Application & Admissions
// ============================================================================

model Application {
  id          String            @id @default(cuid())
  name        String
  email       String
  phone       String
  track       String            // program ID (e.g., "cybersecurity")
  experience  String
  motivation  String            @db.Text
  status      ApplicationStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?           // admin user ID
  reviewNotes String?           @db.Text
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ============================================================================
// Programs & Curriculum
// ============================================================================

model Program {
  id          String @id // e.g., "cybersecurity", "software-engineering"
  title       String
  duration    String
  description String @db.Text

  /*
   * Tuition in kobo — the minor unit of the Naira. Money is an integer count of
   * minor units, never a float: ₦450,000.50 has no exact binary representation
   * and rounding drift on a fee is a real invoice dispute.
   */
  priceKobo Int @default(0)

  modules      Module[]
  enrollments  Enrollment[]
  exams        Exam[]
  projects     Project[]
  certificates Certificate[]
  payments     Payment[]
}

model Enrollment {
  id        String   @id @default(cuid())
  userId    String
  programId String
  startedAt DateTime @default(now())

  /*
   * Defaults to ACTIVE, not PENDING_PAYMENT, and that is deliberate.
   *
   * The schema is applied with `prisma db push`, so adding this column
   * backfills every existing row with the default. Defaulting to
   * PENDING_PAYMENT would lock out every student currently studying. Both
   * creation sites set the value explicitly instead: self-serve registration
   * writes PENDING_PAYMENT, and an admin accepting an application writes ACTIVE.
   */
  status      EnrollmentStatus @default(ACTIVE)
  activatedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId])
  @@index([programId])
  @@index([status])
}

enum EnrollmentStatus {
  PENDING_PAYMENT
  ACTIVE
  SUSPENDED
}

model Module {
  id          String  @id @default(cuid())
  programId   String
  title       String
  description String  @db.Text
  order       Int

  program Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([programId])
}

model Lesson {
  id          String @id @default(cuid())
  moduleId    String
  title       String
  content     String @db.Text  // Markdown
  videoUrl    String?
  order       Int

  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress Progress[]
  resources LessonResource[]

  @@index([moduleId])
}

model LessonResource {
  id        String   @id @default(cuid())
  lessonId  String
  label     String
  url       String
  createdAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

// ============================================================================
// Progress Tracking
// ============================================================================

model Progress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// ============================================================================
// Exams & Assessments
// ============================================================================

model Exam {
  id           String @id @default(cuid())
  programId    String
  title        String
  description  String @db.Text
  passingScore Int    @default(70)  // percentage

  /** Wall-clock minutes from starting a sitting to its hard deadline. */
  durationMinutes Int @default(30)
  /** Sittings allowed per student. 0 means unlimited. */
  maxAttempts     Int @default(3)
  /** Randomise question and option order per sitting. */
  shuffleQuestions Boolean @default(true)

  program   Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  questions ExamQuestion[]
  attempts  ExamAttempt[]
  sessions  ExamSession[]

  @@index([programId])
}

model ExamQuestion {
  id       String @id @default(cuid())
  examId   String
  question String @db.Text
  options  Json   // ["Option A", "Option B", "Option C", "Option D"]
  correct  String // "A", "B", "C", or "D"
  order    Int

  exam Exam @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
}

/**
 * One sitting of an exam.
 *
 * The server owns the clock. `expiresAt` is computed here at start time and is
 * the only deadline that counts — the countdown a student sees is presentation,
 * and a client that lies about the time still submits into an expired session.
 *
 * The shuffled order is frozen at creation rather than re-derived per render.
 * Without that, reloading the page would deal a fresh permutation, which both
 * leaks information across reloads and makes the stored answers ambiguous:
 * "option 2" only means something against a known ordering.
 */
model ExamSession {
  id        String   @id @default(cuid())
  userId    String
  examId    String
  startedAt DateTime @default(now())
  expiresAt DateTime
  status    ExamSessionStatus @default(ACTIVE)

  /** string[] of ExamQuestion ids, in the order this student was shown them. */
  questionOrder Json
  /** Record<questionId, number[]> — the option permutation per question. */
  optionOrder   Json
  /** Answers saved as the student works, so a forced submit still grades real work. */
  savedAnswers  Json?

  /** Focus loss, paste attempts, and similar. Three ends the sitting. */
  violations   Int   @default(0)
  violationLog Json?

  submittedAt DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  attempt ExamAttempt?

  @@index([userId])
  @@index([examId])
  @@index([status])
}

enum ExamSessionStatus {
  ACTIVE
  SUBMITTED
  EXPIRED
  VOIDED
}

model ExamAttempt {
  id          String   @id @default(cuid())
  userId      String
  examId      String
  score       Int      // percentage 0-100
  answers     Json     // Record<questionId, selectedOption>
  passed      Boolean
  attemptedAt DateTime @default(now())

  /** Null for attempts recorded before proctoring existed. */
  sessionId     String?  @unique
  /** True when the deadline or a violation lockout ended the sitting, not the student. */
  autoSubmitted Boolean  @default(false)
  violations    Int      @default(0)

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam    Exam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  session ExamSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([examId])
}

// ============================================================================
// Projects & Submissions
// ============================================================================

model Project {
  id           String @id @default(cuid())
  programId    String
  title        String
  description  String @db.Text
  requirements String @db.Text

  program     Program             @relation(fields: [programId], references: [id], onDelete: Cascade)
  submissions ProjectSubmission[]
  rubricItems ProjectRubricItem[]

  @@index([programId])
}

model ProjectRubricItem {
  id        String @id @default(cuid())
  projectId String
  label     String
  points    Int
  order     Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectSubmission {
  id          String           @id @default(cuid())
  userId      String
  projectId   String
  repoUrl     String?
  demoUrl     String?
  description String           @db.Text
  status      SubmissionStatus @default(PENDING)
  feedback    String?          @db.Text
  submittedAt DateTime         @default(now())
  reviewedAt  DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  feedbackThread ProjectFeedback[]

  @@index([userId])
  @@index([projectId])
  @@index([status])
}

model ProjectFeedback {
  id           String   @id @default(cuid())
  submissionId String
  authorName   String
  authorRole   Role
  body         String   @db.Text
  createdAt    DateTime @default(now())

  submission ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

enum SubmissionStatus {
  PENDING
  APPROVED
  NEEDS_REVISION
}

// ============================================================================
// Certificates
// ============================================================================

model Certificate {
  id               String   @id @default(cuid())
  userId           String
  programId        String
  issuedAt         DateTime @default(now())
  verificationCode String   @unique

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId])
  @@index([programId])
}

// ============================================================================
// Payments
// ============================================================================

/**
 * One tuition payment, per student per programme.
 *
 * Created at registration in the AWAITING_PROOF state — the row exists before
 * any money moves, because it is what the payment screen renders from and what
 * carries the reference the student quotes on the transfer.
 */
model Payment {
  id        String @id @default(cuid())
  userId    String
  programId String

  /** Quoted to the student and expected on the bank narration, e.g. CYC-7K2QW4. */
  reference String @unique
  /*
   * The fee as it stood when this student registered, in kobo. A snapshot, not
   * a lookup: Program.priceKobo can change for a later cohort, and that must
   * not retroactively alter what someone already agreed to pay.
   */
  amountKobo Int

  status   PaymentStatus   @default(AWAITING_PROOF)
  provider PaymentProvider @default(MANUAL)

  reviewedAt  DateTime?
  reviewedBy  String? // admin user ID
  reviewNotes String? @db.Text

  createdAt DateTime @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  proof   PaymentProof?

  @@unique([userId, programId])
  @@index([userId])
  @@index([status])
}

enum PaymentStatus {
  AWAITING_PROOF
  PENDING
  APPROVED
  REJECTED
}

enum PaymentProvider {
  MANUAL
  PAYSTACK
}

/**
 * The uploaded receipt.
 *
 * A separate table purely so the bytes are not dragged along by every query
 * that lists payments — Prisma returns all scalars unless a `select` says
 * otherwise, so a Bytes column on Payment would stream every receipt into the
 * admin queue. Here the blob only loads when something joins to it on purpose.
 */
model PaymentProof {
  id         String   @id @default(cuid())
  paymentId  String   @unique
  data       Bytes
  mimeType   String
  fileName   String
  size       Int
  uploadedAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Timetable
// ============================================================================

model TimetableEntry {
  id          String   @id @default(cuid())
  programId   String
  title       String
  description String?  @db.Text
  startTime   DateTime
  endTime     DateTime
  location    String?
  createdAt   DateTime @default(now())

  @@index([programId])
  @@index([startTime])
}

// ============================================================================
// Operations
// ============================================================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String    @db.Text
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity])
  @@index([createdAt])
}
